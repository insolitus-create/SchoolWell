---
import Base from '../../layouts/Base.astro';
import { locales, withBase, type Locale } from '../../i18n/utils';
import { ui, projectNumber } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const a = t.about;

// Icons follow the order of the corresponding string arrays in ui.ts.
const aimIcons = ['🔍', '💬', '🪞', '🤝', '🗣️', '🌿'];
const resourceIcons = ['🖼️', '❓', '📘', '💻'];
const usageIcons = ['🏫', '👥', '🧑‍🤝‍🧑', '🧑'];
const audienceIcons = ['👩‍🏫', '🧑‍🏫', '🧭', '🧠', '📚', '🤲'];

const partners = [
  {
    role: a.coordinatorRole,
    name: 'Insolitus – Europejska Fundacja Wspierania Edukacji',
    logo: 'partners/insolitus.jpg',
    url: 'http://fundacjainsolitus.pl',
  },
  {
    role: a.partnerRole,
    name: 'Școala Gimnazială “Elena Cuza” Iași',
    logo: 'partners/scoala-elena-cuza.png',
    url: 'https://www.scoalaecuza.ro',
  },
];

const projectWebsite = 'https://schoolwell.weebly.com/';
const displayUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Base lang={lang} title={a.title} description={a.lead}>
  <section class="bg-navy-800 py-14 text-white">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{a.title}</h1>
    </div>
  </section>

  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-6 py-14">
    <!-- Introduction -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.introTitle}</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {
          a.intro.map((text, i) => (
            <div class="flex gap-4 rounded-3xl border border-navy-100 bg-white p-6 shadow-sm">
              <span class="text-3xl leading-none" aria-hidden="true">
                {i === 0 ? '🌱' : '🏫'}
              </span>
              <p class="leading-relaxed text-navy-700">{text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Project aims -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.aimsTitle}</h2>
      <p class="mt-2 text-navy-600">{a.aimsLead}</p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          a.aims.map((aim, i) => (
            <div class="flex items-center gap-4 rounded-2xl border border-navy-100 bg-white p-5 shadow-sm">
              <span
                class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-leaf-50 text-2xl"
                aria-hidden="true"
              >
                {aimIcons[i]}
              </span>
              <span class="font-semibold leading-snug text-navy-900">{aim}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Resources -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.resourcesTitle}</h2>
      <p class="mt-2 max-w-3xl text-navy-600">{a.resourcesLead}</p>
      <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-navy-600">
        {a.resourcesIncludes}
      </p>
      <div class="mt-3 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          a.resources.map((resource, i) => (
            <div class="flex flex-col items-center gap-2 rounded-2xl bg-navy-800 p-5 text-center text-white">
              <span class="text-3xl" aria-hidden="true">
                {resourceIcons[i]}
              </span>
              {resource.value && (
                <span class="text-3xl font-extrabold text-leaf-400">{resource.value}</span>
              )}
              <span class="text-sm font-semibold leading-snug text-navy-100">{resource.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- How the resources can be used -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.usageTitle}</h2>
      <p class="mt-2 text-navy-600">{a.usageLead}</p>
      <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          a.usage.map((item, i) => (
            <div class="flex flex-col items-center gap-3 rounded-2xl border border-leaf-200 bg-leaf-50 p-5 text-center">
              <span class="text-4xl" aria-hidden="true">
                {usageIcons[i]}
              </span>
              <span class="font-semibold text-navy-900">{item}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-4 flex items-center gap-2 text-navy-700">
        <span aria-hidden="true">✨</span>
        {a.usageNote}
      </p>
    </section>

    <!-- Audience -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.audienceTitle}</h2>
      <p class="mt-2 text-navy-600">{a.audienceLead}</p>
      <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
        {
          a.audience.map((who, i) => (
            <div class="flex items-center gap-3 rounded-2xl border border-navy-100 bg-white p-4 shadow-sm">
              <span class="text-3xl" aria-hidden="true">
                {audienceIcons[i]}
              </span>
              <span class="font-semibold leading-snug text-navy-900">{who}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Partners -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.partnersTitle}</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {
          partners.map((partner) => (
            <div class="flex flex-col overflow-hidden rounded-3xl border border-navy-100 bg-white shadow-sm">
              <div class="flex h-40 items-center justify-center border-b border-navy-100 p-6">
                <img
                  src={withBase(partner.logo)}
                  alt={partner.name}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
              <div class="flex flex-1 flex-col gap-2 p-6">
                <span class="text-xs font-semibold uppercase tracking-wide text-leaf-700">
                  {partner.role}
                </span>
                <span class="text-lg font-bold leading-tight text-navy-900">{partner.name}</span>
                <span class="mt-auto pt-2 text-sm text-navy-600">
                  {a.website}:{' '}
                  <a
                    href={partner.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-navy-700 underline hover:text-leaf-700"
                  >
                    {displayUrl(partner.url)}
                  </a>
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Project information -->
    <section>
      <h2 class="text-2xl font-bold tracking-tight text-navy-900">{a.infoTitle}</h2>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-navy-100 bg-white p-5 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">🇪🇺 {a.programmeLabel}</dt>
          <dd class="mt-1 font-semibold text-navy-900">Erasmus+</dd>
        </div>
        <div class="rounded-2xl border border-navy-100 bg-white p-5 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">🎯 {a.actionLabel}</dt>
          <dd class="mt-1 font-semibold text-navy-900">
            KA210-SCH – Small-scale partnerships in school education
          </dd>
        </div>
        <div class="rounded-2xl border border-navy-100 bg-white p-5 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">
            #️⃣ {t.footer.projectNoLabel}
          </dt>
          <dd class="mt-1 break-all font-semibold text-navy-900">{projectNumber}</dd>
        </div>
        <div class="rounded-2xl border border-navy-100 bg-white p-5 shadow-sm">
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">
            🌐 {a.projectWebsiteLabel}
          </dt>
          <dd class="mt-1">
            <a
              href={projectWebsite}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-navy-700 underline hover:text-leaf-700"
            >
              {displayUrl(projectWebsite)}
            </a>
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Base>
