---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { localePath, type Locale } from '../../../i18n/utils';
import { ui } from '../../../i18n/ui';
import { checkParity } from '../../../i18n/parity';

export async function getStaticPaths() {
  const entries = await getCollection('activities');
  checkParity(
    entries.map((e) => e.id),
    'activities',
  );
  return entries.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    return { params: { lang, slug: rest.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <a
      href={localePath(lang, 'activities/')}
      class="text-sm font-semibold text-leaf-600 hover:text-leaf-700"
    >
      ← {t.activities.back}
    </a>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight">{entry.data.title}</h1>

    <dl class="mt-5 grid gap-4 rounded-2xl border border-navy-100 bg-white p-5 shadow-sm sm:grid-cols-2">
      {
        [
          { emoji: '👥', label: t.activities.format, value: entry.data.format },
          { emoji: '⏱', label: t.activities.time, value: entry.data.time },
          { emoji: '💻', label: t.activities.app, value: entry.data.app },
          { emoji: '🎯', label: t.activities.goal, value: entry.data.goal, wide: true },
        ]
          .filter((item) => item.value)
          .map((item) => (
            <div class:list={[item.wide && 'sm:col-span-2']}>
              <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">
                <span aria-hidden="true">{item.emoji}</span> {item.label}
              </dt>
              <dd class="mt-1 font-medium">{item.value}</dd>
            </div>
          ))
      }
    </dl>

    <div class="prose prose-slate mt-8 max-w-none prose-headings:text-navy-900 prose-a:text-leaf-700">
      <Content />
    </div>
  </article>
</Base>
